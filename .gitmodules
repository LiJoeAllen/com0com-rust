# mir-am：AI 编码助手的 Agents & Skills。
[submodule ".agent/skills/skills-agents-ai-coding"]
    path = .agent/skills/skills-agents-ai-coding
    url = https://github.com/mir-am/skills-agents-ai-coding.git
