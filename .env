# =============================================================================
# com0com-rust 环境清单
# =============================================================================
# 这是团队共享的**模板**：列出项目构建与虚拟机端到端测试所需的全部可配置项。
#
# 用法（新机器首次配置）：
#   1. cp .env .env.local
#   2. 编辑 .env.local 填入你自己的本机路径与凭据
#   3. 加载后即可照常执行 tools/ 下的脚本
#
# 加载方式：
#   PowerShell:  . tools/load-env.ps1      # 注意前面有个点，表示 dot-source
#   Git Bash:    source tools/load-env.sh
#
# 安全性（务必遵守）：
#   - .env        入库，只放**占位值/默认值**，禁止写真实口令、证书私钥、Token
#   - .env.local  已 gitignore，本机私密值一律写在这里，它最后加载并覆盖 .env
#   - 若某个值不想落盘，删除该行即可，直接用系统环境变量提供同样生效
#
# 脚本取值优先级：命令行显式传参 > 环境变量 > .env.local > .env > 脚本内置默认值
# =============================================================================


# -----------------------------------------------------------------------------
# 一、构建环境
# -----------------------------------------------------------------------------

# WDK 内容根目录。必须指向含 Include\<ver>\km 与 Lib\wdf\kmdf 的那个 Windows
# Kits\10 目录——只装 Windows SDK 是不够的：缺 km 头文件时 wdk-sys 的 bindgen
# 会把结构体解析成不完整类型，编译会爆出成片的 E0080 size_of 溢出。
# 留空则由脚本自动探测 %ProgramFiles%\Windows Kits\10。
# 例：WDKContentRoot=C:\Program Files (x86)\Windows Kits\10
WDKContentRoot=

# cargo 并行任务数。内核 crate 首次构建要用 bindgen 解析整套 WDK 头文件，
# 非常吃 CPU；低配机务必保持较小值，否则容易把机器拖到无响应。
CARGO_BUILD_JOBS=2

# libclang 18 的 native 目录。**必须是 18.x（18.1.1 已验证）**——22.1.x 有回归：
# clang_getTypeDeclaration 对 `typedef struct X X; struct X {...};` 返回前向声明而非
# 定义，bindgen 会生成 `_address: u8` 占位，最终导致 wdk-sys 编译爆出成片的
# `E0080 attempt to compute 1_usize - N_usize`（结构体 size 退化成 1）。
# 安装：py -m pip install "libclang==18.1.1" --target tools/libclang18
LIBCLANG_PATH=target/libclang18/clang/native

# 给 bindgen 的额外 clang 参数。WDK 自带的 km 头会用到 Windows SDK 的
# shared/ucrt/um 头文件，而 WDK 28000 的 Include 下并没有这些，必须显式指过去。
# 注意两点：bindgen 按空白切分，路径**不能含空格**（含空格先建 junction）；
# junction 建立方式（管理员一次即可）：
#   cmd /c mklink /J target\sdk26100 "C:\Program Files (x86)\Windows Kits\10\Include\10.0.26100.0"
BINDGEN_EXTRA_CLANG_ARGS=-I target/sdk26100/shared -I target/sdk26100/ucrt -I target/sdk26100/um


# -----------------------------------------------------------------------------
# 二、虚拟机端到端测试（tools/vm-test）
# -----------------------------------------------------------------------------
# 对应 tools/vm-test/run-vm-test.ps1 的参数。填写后可直接：
#     . tools/load-env.ps1
#     pwsh -File tools/vm-test/run-vm-test.ps1
# 命令行显式传参仍然优先于这里的值。

# VMware 虚拟机配置文件（.vmx）的完整路径。必填，除非你每次都手动传 -VmxPath。
VMRUN_VMX_PATH=

# 客户机管理员账号。敏感值，建议只写在 .env.local。
VMRUN_GUEST_USER=

# 客户机口令。敏感值，务必只写在 .env.local。
VMRUN_GUEST_PASSWORD=

# vmrun.exe 的完整路径。留空时脚本会自动搜索常见安装位置。
# 例：VMRUN_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe
VMRUN_PATH=

# 要回滚到的快照名（该快照需处于关机状态）。留空表示不回滚，直接用当前状态。
VMRUN_SNAPSHOT_NAME=

# 构建配置：debug 或 release。
VM_TEST_CONFIGURATION=debug

# 构建时的并行任务数，同 CARGO_BUILD_JOBS 的考量。
VM_TEST_JOBS=2
