# Rust 构建产物（含各独立 workspace 根，如 crates/com0combus/target）
target/

# OS / 编辑器
.DS_Store
.idea/
.vscode/

# 内核驱动 / 用户态工具构建产物（不应入库，由 CI/本地构建产生）
*.sys
*.exe
*.pdb

# 本地调试/崩溃分析产物（根目录；验证流程的日志应留在 target/）
/*.log
/*.dmp
/crash-analyze.txt
/probe_*.txt

# 本地 Agent 记忆（.agent/memory，不入版本库；.agent/knowledge 与 .agent/skills 需入库）
.agent/memory/

# 本机私密环境（口令、本机路径）——模板 .env 入库，实际值放 .env.local
.env.local
